{
  "name": "@post-it/api",
  "author": "IT PTPL",
  "version": "0.0.30",
  "description": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "sonar": "sonar-scanner",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "start:migrate:prod": "npx prisma migrate deploy && npm run start:prod",
    "start:migrate:reset": "npx prisma migrate reset && npx prisma db seed && npm run start:prod",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "docker:dev:build": "docker buildx build --platform=linux/amd64 -t asia-southeast2-docker.pkg.dev/ptpl-devops-dev/docker-dev/post-api-dev:latest -f devops/Dockerfile .",
    "docker:dev:push": "docker push asia-southeast2-docker.pkg.dev/ptpl-devops-dev/docker-dev/post-api-dev:latest",
    "gke:dev:deploy": "kubectl apply -f devops/dev/postit-api-secret.yaml,devops/dev/postit-api-sa.yaml,devops/dev/postit-api-s.yaml,devops/dev/postit-api-deploy.yaml",
    "docker:prd:build": "docker buildx build --platform=linux/amd64 -t asia-southeast2-docker.pkg.dev/ptpl-devops-prod/docker-prod/post-api-prod:latest -f devops/Dockerfile .",
    "docker:prd:push": "docker push asia-southeast2-docker.pkg.dev/ptpl-devops-prod/docker-prod/post-api-prod:latest",
    "gke:prd:deploy": "kubectl apply -f devops/prod/postit-api-secret.yaml,devops/prod/postit-api-sa.yaml,devops/prod/postit-api-s.yaml,devops/prod/postit-api-deploy.yaml"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^7.9.4",
    "@google-cloud/storage": "^7.18.0",
    "@google-cloud/vertexai": "^1.10.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.10",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.10",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.10",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "axios": "^1.13.5",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^16.6.1",
    "multer": "^2.1.1",
    "nodemailer": "^7.0.12",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-headerapikey": "^1.2.2",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "qs": "^6.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.10",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.7.4",
    "prisma": "^7.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleNameMapper": {
      "src/(.*)": "<rootDir>/$1"
    },
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "axios": ">=1.13.5",
      "tar": ">=7.5.10",
      "fast-xml-parser": ">=5.3.8",
      "minimatch": ">=10.2.3",
      "lodash": ">=4.17.23",
      "hono": ">=4.12.4",
      "@hono/node-server": ">=1.19.10",
      "serialize-javascript": ">=7.0.3",
      "@tootallnate/once": ">=3.0.1",
      "multer": ">=2.1.1",
      "@angular-devkit/core": "~19.2.22",
      "@angular-devkit/schematics": "~19.2.22",
      "@angular-devkit/schematics-cli": "~19.2.22",
      "qs": ">=6.14.2"
    }
  }
}