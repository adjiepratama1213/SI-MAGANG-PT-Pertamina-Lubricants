// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

/// TODO: Identity
/// Login Info
enum Role {
  SUPERSAIYAN
  EMPLOYEE
  PESERTA
  EMPLOYEESTAFF
}

/// Login Info
enum UserStatus {
  active
  pending
  banned
  rejected
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email           String     @unique @db.VarChar(255)
  password        String     @db.Text
  status          UserStatus @default(active)
  role            Role       @default(EMPLOYEE)
  name            String     @db.VarChar(255)
  jobTitle        String?
  photoUrl        String?
  idamanId        String?
  webAuthnId      String     @unique @db.VarChar(255)
  phone           String?
  encryptedSecret String?
  hashBackupCode  String?

  Position Position? @relation(fields: [positionId], references: [id])

  positionId       String?
  QrLoginToken     QrLoginToken[]

  // Relasi ke profil karyawan internal (VP, Mentor, Admin)
  employeeProfile EmployeeProfile? @relation("UserToEmployeeProfile")

  // Relasi ke profil peserta magang
  internProfile   InternProfile?   @relation("UserToInternProfile")

  // Relasi ke notifikasi & pengumuman
  notifications          Notification[]
  remindersCreated       AdminReminder[]
  mentorRemindersCreated MentorReminder[]

  @@index([role])
  @@index([positionId])
}

model QrLoginToken {
  id        String        @id @default(uuid())
  token     String        @unique @db.VarChar(255)
  status    QrTokenStatus @default(PENDING)
  user      User?         @relation(fields: [userId], references: [id])
  userId    String? // terisi setelah user approve
  createdAt DateTime      @default(now())
  expiresAt DateTime // otomatis expired
  usedAt    DateTime?

  @@index([token])
}

enum QrTokenStatus {
  PENDING
  APPROVED
  USED
  EXPIRED
}

model UserLog {
  id        String   @id @default(uuid())
  userId    String // ID user yang memanggil
  endpoint  String // misalnya: "me"
  timestamp DateTime @default(now())
  ip        String? // jika kamu ingin log IP
  userAgent String? // jika ingin log UA
}

model Organization {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isPublished Boolean @default(false)
  kuota       Int     @default(0)

  name        String
  companyCode String

  positions Position[] @relation(name: "PositionOrganization")
  teams     Position[] @relation(name: "PositionTeam")

  child    Organization[] @relation("org")
  Parent   Organization?  @relation("org", fields: [parentId], references: [id])
  parentId String?
}

model Position {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String

  teamId               String? // team id is calculated id by idaman
  organizationId       String
  organizationParentId String?
  isChief              Boolean
  isHead               Boolean
  isOwner              Boolean
  isPublished          Boolean
  isSync               Boolean

  User         User[]
  Organization Organization  @relation(fields: [organizationId], references: [id], name: "PositionOrganization")
  Team         Organization? @relation(fields: [teamId], references: [id], name: "PositionTeam")
}

// ----------------------------------------------------
// PROFIL KARYAWAN INTERNAL (VP, Mentor, Admin)
// Skala Pertamina Wide — Jabatan, Direktorat, Fungsi
// ----------------------------------------------------
enum Gender {
  PRIA
  WANITA
}

model EmployeeProfile {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId     String @unique
  user       User   @relation("UserToEmployeeProfile", fields: [userId], references: [id], onDelete: Cascade)

  employeeId String? @unique // NIP / ID Pegawai Pertamina
  jabatan    String? // Jabatan (Konteks Pertamina)
  direktorat String? // Direktorat
  fungsi     String? // Fungsi
  subFungsi  String? // Sub Fungsi
  gender     Gender? // Jenis Kelamin

  // Jika karyawan ini bertindak sebagai Mentor, dia punya relasi ke anak magang
  internsMentored InternProfile[] @relation("MentorToIntern")
}

// ----------------------------------------------------
// PROFIL PESERTA MAGANG
// ----------------------------------------------------
model InternProfile {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation("UserToInternProfile", fields: [userId], references: [id], onDelete: Cascade)

  // Data Spesifik Peserta
  internId    String?   @unique // Id Peserta / NIM
  university  String?   // Asal Instansi
  gender      Gender?   // Jenis Kelamin
  dateOfBirth DateTime? // Tanggal Lahir
  major       String?   // Jurusan
  startDate   DateTime? // Tanggal Mulai Magang
  endDate     DateTime? // Tanggal Selesai Magang
  program     String?   // Program Magang
  bankName    String?   // Nama Bank
  bankAccount String?   // Nomor Rekening
  documentUrls String[] @default([])   // Berkas (Multiple Links)

  // Relasi ke Karyawan yang menjadi Mentor
  mentorProfileId String?
  mentor          EmployeeProfile? @relation("MentorToIntern", fields: [mentorProfileId], references: [id])
  Laporan         Laporan[]
  presensi          Presensi[]
  evaluation        InternEvaluation?
  extensionRequests InternExtensionRequest[]
  feedbacks         InternFeedback[]
}

model Laporan {
  id             String        @id @default(uuid())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  keterangan     String?
  files          String[]      @default([]) // links to the uploaded files
  statusFeedback String        @default("Menunggu Evaluasi")
  komentar       String?

  internId       String
  intern         InternProfile @relation(fields: [internId], references: [id], onDelete: Cascade)
}

enum PresensiStatus {
  HADIR
  HADIR_TERLAMBAT
  ALPHA
  IZIN
  SAKIT
}

model Presensi {
  id              String        @id @default(uuid())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  internProfileId String
  internProfile   InternProfile @relation(fields: [internProfileId], references: [id], onDelete: Cascade)

  tanggalInput    DateTime
  masuk           DateTime?
  keluar          DateTime?
  lat             String?
  lng             String?
  presensiStatus  PresensiStatus
  fileBukti       String?
  keterangan      String?
}

model InternEvaluation {
  id              String        @id @default(uuid())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  internProfileId String        @unique
  internProfile   InternProfile @relation(fields: [internProfileId], references: [id], onDelete: Cascade)

  integritas       Float
  ketepatanWaktu   Float
  keahlian         Float
  kerjasama        Float
  komunikasi       Float
  penggunaanTI     Float
  pengembanganDiri Float
  catatan          String?

  nilaiRataRata    Float
  kategori         String
  certificateUrl   String?
}

model InternExtensionRequest {
  id              String        @id @default(uuid())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  internProfileId String
  internProfile   InternProfile @relation(fields: [internProfileId], references: [id], onDelete: Cascade)

  previousEndDate DateTime
  newEndDate      DateTime
  reason          String?
  status          String        @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNote       String?
}

// ----------------------------------------------------
// SISTEM NOTIFIKASI, REMINDER & FEEDBACK
// ----------------------------------------------------

enum NotificationCategory {
  REMINDER_ADMIN   // Pengumuman / Reminder manual dari Admin
  FEEDBACK_PESERTA // Feedback dari peserta untuk Admin
  PRESENSI         // Check-in, check-out, izin, sakit
  LAPORAN          // Upload logbook, feedback mentor
  BERKAS           // Validasi pendaftaran, revisi dokumen
  EVALUASI         // Nilai akhir, sertifikat
  APPROVAL_VP      // Kuota & persetujuan manajemen
  SISTEM           // Info teknis sistem
  REMINDER_MENTOR  // Reminder / Tugas dari Mentor untuk Peserta Bimbingan
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  URGENT
}

model Notification {
  id          String               @id @default(uuid())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  userId      String               // Penerima notifikasi
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String               @db.VarChar(255)
  message     String               @db.Text
  category    NotificationCategory @default(SISTEM)
  type        NotificationType     @default(INFO)
  isRead      Boolean              @default(false)
  redirectUrl String?              // URL redirect saat diklik
  metadata    Json?                // Data tambahan

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum ReminderTarget {
  ALL
  PESERTA
  MENTOR
  VP
}

model AdminReminder {
  id          String           @id @default(uuid())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  title       String           @db.VarChar(255)
  content     String           @db.Text
  target      ReminderTarget   @default(ALL)
  urgency     NotificationType @default(INFO)
  fileUrl     String?          // URL lampiran berkas (opsional)
  fileName    String?          // Nama asli berkas lampiran

  createdById String
  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([target])
  @@index([createdAt])
}

model MentorReminder {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  title            String   @db.VarChar(255)
  content          String   @db.Text
  tipe             String   @default("informasi") // "tugas" | "informasi" | "lainnya"
  targetType       String   @default("semua")     // "semua" | "spesifik"
  targetPesertaIds String[] @default([])
  targetNames      String[] @default([])
  jadwal           DateTime?
  openedAt         DateTime?
  dueAt            DateTime?
  fileUrls         String[] @default([])
  fileNames        String[] @default([])
  status           String   @default("Terkirim")  // "Terkirim" | "Terjadwal"

  createdById      String
  createdBy        User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([createdAt])
}

model InternFeedback {
  id          String        @id @default(uuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  internId    String
  intern      InternProfile @relation(fields: [internId], references: [id], onDelete: Cascade)

  category    String        // Fasilitas, Mentor, Sistem, Umum
  rating      Int           @default(5)
  message     String        @db.Text
  isAnonymous Boolean       @default(false)
  status      String        @default("Baru") // Baru, Ditinjau, Ditindaklanjuti
  response    String?       @db.Text

  @@index([internId])
  @@index([createdAt])
}