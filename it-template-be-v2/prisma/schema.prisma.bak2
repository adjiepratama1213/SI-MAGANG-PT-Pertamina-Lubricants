// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// TODO: Identity
/// Login Info
enum Role {
  PTPL_IT
  PTPL_QA
  PTPL_PROD
  VENDOR
  GUEST
  SUPERSAIYAN
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email    String  @unique @db.VarChar(255)
  password String  @db.Text
  role     Role    @default(GUEST)
  name     String  @db.VarChar(255)
  phone    String?

  Vendor   Vendor? @relation(fields: [vendorId], references: [id])
  vendorId Int?

  VendorPlan VendorPlan[]
  VendorReal VendorReal[]
  ProdUsage  ProdUsage[]
  QACheck    QACheck[]

  @@index([role])
  @@index([vendorId])
}

model Vendor {
  id        Int      @id /// ID Vendor SAP
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name    String
  address String?
  notes   String?

  User User[]
  Plan VendorPlan[]
  Real VendorReal[]
}

///-------------------------------------------------------------------------------------------------

/// TODO: ITPTPL Section
/// Master Data QR Codes
model QRMaster {
  qr        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 0:available, 1:booked, 2:planned, 3:created, 4:broken, 5:producted
  status Int @default(0)

  VendorPlan   VendorPlan? @relation(fields: [vendorPlanId], references: [id])
  vendorPlanId Int?
  VendorReal   VendorReal? @relation(fields: [vendorRealId], references: [id])
  vendorRealId Int?
  ProdUsage    ProdUsage?  @relation(fields: [prodUsageId], references: [id])
  prodUsageId  Int?

  QACheck QACheckDetail?

  // QACheckDetail   QACheckDetail @relation(fields: [qACheckDetailId], references: [id])
  // qACheckDetailId Int

  @@index([status])
  @@index([vendorPlanId])
  @@index([vendorRealId])
  @@index([prodUsageId])
}

///-------------------------------------------------------------------------------------------------

/// TODO: Vendor Section
/// Rencana Pemakaian QR (General)
model VendorPlan {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name      String /// Sequence
  productId String?
  reqDate   DateTime @default(now()) @db.Date
  qty       Int
  dlTimes   Int      @default(0) /// 0:never used, 1-3:warning, 4:locked, 5:expired

  Vendor   Vendor @relation(fields: [vendorId], references: [id])
  vendorId Int

  user   User   @relation(fields: [userId], references: [id])
  userId String

  QRCodes QRMaster[]

  @@unique([vendorId, reqDate, name])
  @@index([vendorId])
  @@index([vendorId, reqDate])
}

/// Realisasi Produksi oleh Vendor (Printed)
model VendorReal {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prodDate DateTime @db.Date
  prodNum  String
  product  String?

  Vendor   Vendor @relation(fields: [vendorId], references: [id])
  vendorId Int

  user   User   @relation(fields: [userId], references: [id])
  userId String

  QRCodes QRMaster[]

  QACheck QACheck[]

  @@unique([vendorId, prodNum])
  @@index([vendorId, prodDate])
}

///-------------------------------------------------------------------------------------------------

/// TODO: QA Check Section
model QACheck {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     String?

  checkDate DateTime
  plant     String
  product   String
  status    Int      @default(0) /// 0:drafted, 1:passed, 2:rejected, 3:pending

  VendorReal   VendorReal @relation(fields: [vendorRealId], references: [id])
  vendorRealId Int

  user   User   @relation(fields: [userId], references: [id])
  userId String

  ProdUsage ProdUsage[]
  Details   QACheckDetail[]

  @@index([plant, product])
  @@index([plant, product, status])
  @@index([product, status])
}

/// Untuk memfasilitasi QR yang tidak ada dalam database QR Master
model QACheckDetail {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     String?

  status Int @default(0) /// 0:drafted, 1:passed, 2:rejected, 3:pending

  Ref   QACheck @relation(fields: [refId], references: [id])
  refId Int

  QRMasterUsed QRMaster? @relation(fields: [qrChecked], references: [qr])
  qrChecked    String    @unique

  @@index([refId])
}

///-------------------------------------------------------------------------------------------------

/// TODO: Prod PTPL Section
/// Realisasi Pemakaian QR (General)
model ProdUsage {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prodDate DateTime @db.Date
  plant    String   @db.VarChar(4)
  kimap    String /// Product
  batch    String?  @db.VarChar(8)
  notes    String?

  QAChecked QACheck[]

  user   User   @relation(fields: [userId], references: [id])
  userId String

  QRCodes QRMaster[]

  @@index([kimap])
  @@index([plant])
  @@index([plant, kimap])
  @@index([plant, kimap, prodDate])
  @@index([plant, prodDate])
}
