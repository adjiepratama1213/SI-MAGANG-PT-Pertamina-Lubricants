    "@mui/icons-material": "^5.16.4",
    "@mui/lab": "5.0.0-alpha.170",
    "@mui/material": "^5.16.4",
    "@mui/x-date-pickers": "^7.11.0",
    "@tanstack/react-query": "^5.51.11",
    "@yudiel/react-qr-scanner": "^2.0.4",
    "apexcharts": "^3.54.1",
    "autosuggest-highlight": "^3.3.4",
    "axios": "^1.13.5",
    "date-fns": "^3.6.0",
