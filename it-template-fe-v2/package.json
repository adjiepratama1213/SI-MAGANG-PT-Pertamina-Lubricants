{
  "name": "post-it",
  "author": "IT PTPL",
  "version": "1.0.26",
  "description": "Team Documentation Management Apps",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "serve-storybook": "serve storybook-static",
    "sonar": "sonar-scanner",
    "dev": "vite",
    "build": "tsc --project tsconfig.node.json && vite build",
    "build:run": "serve -s dist",
    "build:deploy": "gsutil -m cp -r dist/* gs://post-fe",
    "start": "vite preview",
    "start:dev": "npm run build && npm run start",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "prettier": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "clear-all": "rm -rf node_modules .next out dist build",
    "re-start": "rm -rf node_modules .next out dist build && yarn install && yarn dev",
    "re-build": "rm -rf node_modules .next out dist build && yarn install && yarn build",
    "re-build-test": "rm -rf node_modules .next out dist build && npm install && npm run build",
    "docker:dev:build": "docker buildx build --platform=linux/amd64 -t asia-southeast2-docker.pkg.dev/ptpl-devops-dev/docker-dev/post-fe-dev:latest -f devops/Dockerfile.staging .",
    "docker:dev:push": "docker push asia-southeast2-docker.pkg.dev/ptpl-devops-dev/docker-dev/post-fe-dev:latest",
    "cloudrun:dev:deploy": "gcloud run deploy post-it-fe --image asia-southeast2-docker.pkg.dev/ptpl-devops-dev/docker-dev/post-fe-dev:latest --platform managed --region asia-southeast2 --project ptpl-devops-dev --allow-unauthenticated",
    "docker:prd:build": "docker buildx build --platform=linux/amd64 -t asia-southeast2-docker.pkg.dev/ptpl-devops-prod/docker-prod/post-fe-prod:latest -f devops/Dockerfile .",
    "docker:prd:push": "docker push asia-southeast2-docker.pkg.dev/ptpl-devops-prod/docker-prod/post-fe-prod:latest",
    "cloudrun:prd:deploy": "gcloud run deploy post-it-fe --image=asia-southeast2-docker.pkg.dev/ptpl-devops-prod/docker-prod/post-fe-prod:latest --service-account=postit@ptpl-devops-prod.iam.gserviceaccount.com --region=asia-southeast2 --project=ptpl-devops-prod && gcloud run services update-traffic post-it-fe --region=asia-southeast2 --to-latest"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.2.4",
    "@emotion/cache": "^11.14.0",
    "@emotion/is-prop-valid": "^1.4.0",
    "@emotion/react": "^11.14.0",
