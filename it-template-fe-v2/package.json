    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "prettier": "^3.7.4",
    "sonarqube-scanner": "^4.3.2",
    "storybook": "^8.6.17",
    "typescript": "^5.5.3",
    "vite": "^5.4.21"
  },
  "pnpm": {
